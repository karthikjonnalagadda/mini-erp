# =============================================================================
# Mini ERP + CRM — Frontend environment
#
# Only VITE_-prefixed variables reach the browser. That prefix is a SECURITY
# BOUNDARY, not a naming convention: anything exposed here is compiled into the
# bundle and readable by anyone who opens devtools. Never put a secret in this
# file.
# =============================================================================

# Absolute API origin.
#
# LEAVE UNSET IN DEVELOPMENT. When empty the client falls back to `/api/v1`,
# which the Vite dev server proxies to the backend — keeping requests
# same-origin so the httpOnly refresh cookie works without HTTPS locally.
#
# In production (Vercel) set this to the deployed API, including the prefix:
#   VITE_API_BASE_URL=https://mini-erp-crm-api.onrender.com/api/v1
# VITE_API_BASE_URL=

# Overrides the dev-server proxy target if the backend runs on another port.
# VITE_DEV_API_TARGET=http://localhost:4000

VITE_APP_NAME=Mini ERP + CRM
