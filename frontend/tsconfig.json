{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — Vite handles resolution and transpilation, so this config
       never emits. A single config covers both `src` and `vite.config.ts`
       rather than the usual three-file project-reference setup: references
       require `composite` (which forbids `noEmit`), and the resulting conflict
       buys nothing for a project this size. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Node types are needed by vite.config.ts (`node:path`, `process.env`). */
    "types": ["node", "vite/client"],

    /* Strictness matching the backend. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,

    /* Path alias — Vite rewrites these at bundle time. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
