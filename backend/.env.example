# =============================================================================
# Mini ERP + CRM — Backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable below is validated at boot by src/config/env.ts — the process
# refuses to start if anything is missing or malformed (fail fast, not at 3am).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Database ----------------------------------------------------------------
# Local Docker Compose:
#   postgresql://erp:erp_password@localhost:5432/mini_erp?schema=public
# Neon (production) — note the required `sslmode=require`:
#   postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/mini_erp?sslmode=require
DATABASE_URL=postgresql://erp:erp_password@localhost:5432/mini_erp?schema=public

# --- JWT ---------------------------------------------------------------------
# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Access and refresh secrets MUST be different — a leaked access secret must not
# be able to mint refresh tokens.
JWT_ACCESS_SECRET=replace_me_with_a_64_char_random_hex_string_for_access_tokens
JWT_REFRESH_SECRET=replace_me_with_a_different_64_char_random_hex_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Password hashing --------------------------------------------------------
# 12 is a sane 2025 default (~250ms/hash). Lower it only for tests.
BCRYPT_SALT_ROUNDS=12

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Logging -----------------------------------------------------------------
# error | warn | info | http | debug
LOG_LEVEL=debug

# --- Seed ---------------------------------------------------------------------
# Credentials created by `npm run db:seed`. Change before any public deployment.
SEED_ADMIN_EMAIL=admin@erpportal.io
SEED_ADMIN_PASSWORD=Admin@12345
